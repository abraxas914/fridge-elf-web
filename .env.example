# Server-only Web Demo configuration.
# Keep every value in local .env.local or Vercel Environment Variables.
# Never use a VITE_ prefix for these values.

# At least 16 random characters; signs anonymous two-hour Demo sessions.
DEMO_SESSION_SECRET=

# OpenAI-compatible read-only text gateway.
HEADLESS_GATEWAY_BASE_URL=
HEADLESS_GATEWAY_API_KEY=
HEADLESS_GATEWAY_DEFAULT_MODEL=

# OpenAI-compatible Image 2 gateway.
HEADLESS_IMAGE_GATEWAY_BASE_URL=
HEADLESS_IMAGE_GATEWAY_API_KEY=
HEADLESS_IMAGE_GATEWAY_MODEL=
