{
  "name": "fridge-elf-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && npm run typecheck:api && vite build",
    "build:rth": "RTH_BUILD=1 npm run build && node scripts/prepare-rth-dist.mjs",
    "deploy:rth": "deno -Ar https://host.retiehe.com/cli deploy",
    "test:rth-html": "node --test scripts/retinbox-html.node-test.mjs scripts/retinbox-workflow.node-test.mjs",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "capture:readme": "node scripts/capture-readme-assets.mjs",
    "demo-link": "node scripts/create-demo-link.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
